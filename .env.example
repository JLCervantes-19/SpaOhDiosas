# ============================================================
# ARCHIVO DE EJEMPLO DE CONFIGURACIÓN
# ============================================================
# Copia este archivo a .env y reemplaza los valores con tus credenciales reales
# NUNCA subas el archivo .env a Git (ya está en .gitignore)

# ============================================================
# CONFIGURACIÓN DE SUPABASE
# ============================================================
# Obtén estas credenciales desde: https://app.supabase.com
# Settings → API

SUPABASE_URL=https://xxxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ============================================================
# MULTI-TENANT — QUÉ EMPRESA ES ESTE DESPLIEGUE
# ============================================================
# Cada landing (proyecto de Vercel) sirve a UNA sola empresa. Este
# valor es el "id" de la tabla empresas correspondiente. Si no se
# configura, cae en Empresa 0 (datos de prueba/demo).
# Ver: docs/superpowers/specs/2026-08-11-multitenant-design.md

EMPRESA_ID=00000000-0000-0000-0000-000000000000

# ============================================================
# CONFIGURACIÓN DE N8N WEBHOOK (OPCIONAL)
# ============================================================
# Si tienes un webhook de N8N para respuestas inteligentes,
# coloca la URL aquí. Si no lo configuras, el sistema usará
# respuestas locales automáticamente.

N8N_CHAT_WEBHOOK=https://tu-instancia-n8n.onrender.com/webhook/chatweb

# ============================================================
# CONFIGURACIÓN DEL SERVIDOR
# ============================================================

PORT=3000
FRONTEND_URL=http://localhost:3000

# ============================================================
# OTRAS CONFIGURACIONES
# ============================================================

WHATSAPP_NUMBER=573001234567

# ============================================================
# SEGURIDAD — ACCESO ADMINISTRADOR
# ============================================================
# Token secreto para endpoints de admin (GET /api/bookings/all,
# PATCH /api/bookings/:id/status).
# Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Inclúyelo en las peticiones con el header:  x-admin-token: <valor>

ADMIN_TOKEN=cambia_esto_por_un_token_secreto_largo
